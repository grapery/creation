# Google OAuth Configuration
# Get your Google Client ID from: https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here

# Apple OAuth Configuration (Optional)
NEXT_PUBLIC_APPLE_CLIENT_ID=your-apple-client-id-here

# WeChat OAuth Configuration (Optional)
NEXT_PUBLIC_WECHAT_APP_ID=your-wechat-app-id-here
NEXT_PUBLIC_WECHAT_REDIRECT_URI=http://localhost:3000/auth/wechat/callback

# Stripe Configuration (Optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# GitHub Assets Configuration (Optional)
# Set this to use GitHub as CDN for onboarding images
# Format: https://raw.githubusercontent.com/{username}/{repo}/{branch}/{path}
# 
# Current project setup:
# Images are stored in develop/public directory
# https://github.com/grapery/creation/tree/develop/public
# 
# To use local images instead, leave this empty
NEXT_PUBLIC_GITHUB_ASSETS_URL=https://raw.githubusercontent.com/grapery/creation/develop/public
