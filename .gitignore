coverage/
.nyc_output
*.lcov

# Production
dist/
dist-ssr/
build/
*.local

# Vite
.vite/
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# TypeScript
*.tsbuildinfo
*.d.ts.map

# ESLint
.eslintcache
.stylelintcache

# Parcel
.cache/
.parcel-cache/

# Next.js (if used in future)
.next/
out/

# Storybook
storybook-static/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

